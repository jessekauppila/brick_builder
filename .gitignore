backend/*.scad
backend/*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
atp-backend-main/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
